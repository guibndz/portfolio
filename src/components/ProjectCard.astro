---
import type { CollectionEntry } from 'astro:content';

interface Props {
  projeto: CollectionEntry<'projetos'>;
  destaque?: boolean;
}

const { projeto, destaque = false } = Astro.props;
const { data } = projeto;
const titleId = `projeto-${projeto.id}`;

// Ordem dos links: case, PR, deploy, repositório. O primeiro é o principal.
const links: { href: string; text: string }[] = [];
if (data.temCase) links.push({ href: `/projetos/${projeto.id}`, text: 'Ler o case' });
if (data.pr) links.push({ href: data.pr.url, text: `PR #${data.pr.numero}` });
if (data.deploy) links.push({ href: data.deploy, text: 'Ver no ar' });
links.push({ href: data.repo, text: 'Repositório' });
---

<article class:list={['card', { 'card--featured': destaque }]} aria-labelledby={titleId}>
  <header class="card__head">
    <p class="card__meta">
      <span class:list={['card__type', { 'card__type--team': data.tipo === 'Em equipe' }]}>{data.tipo}</span>
      <span>{data.periodo}</span>
      {data.contexto && <span>{data.contexto}</span>}
    </p>
    <h3 id={titleId}>{data.titulo}</h3>
    <p class="card__subtitle">{data.subtitulo}</p>
  </header>

  <p class="card__problem">{data.problema}</p>
  {data.detalhe && <p class="card__detail">{data.detalhe}</p>}

  {
    data.minhaParte && (
      <div class="card__block">
        <h4 class="label">Minha parte</h4>
        <ul class="card__part">
          {data.minhaParte.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </div>
    )
  }

  {
    data.decisao && (
      <div class="card__block">
        <h4 class="label">Decisão</h4>
        <p class="card__detail">{data.decisao}</p>
      </div>
    )
  }

  <div class="card__foot">
    <h4 class="visually-hidden">Stack</h4>
    <ul class="card__stack" role="list">
      {data.stack.map((item) => <li>{item}</li>)}
    </ul>
    <ul class="card__links" role="list">
      {
        links.map((link, index) => (
          <li>
            <a href={link.href} class:list={{ 'card__link--main': index === 0 }}>
              {link.text}
              <span class="visually-hidden"> do {data.titulo}</span>
              <span aria-hidden="true"> →</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</article>

<style>
  /* Flex em coluna: o rodapé desce até a base quando dois cards dividem a linha. */
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding: var(--space-6) var(--space-5);
    border: var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .card__head {
    display: grid;
    gap: var(--space-2);
  }

  .card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.04em;
    color: var(--text-faint);
  }

  .card__type {
    padding: 0.15rem var(--space-2);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: var(--tracking-label);
  }

  .card__type--team {
    border-color: color-mix(in oklab, var(--accent-text) 50%, transparent);
    color: var(--accent-text);
  }

  .card h3 {
    margin-block-start: var(--space-2);
  }

  .card__subtitle {
    color: var(--text-muted);
  }

  .card__problem {
    max-width: 60ch;
    font-size: var(--text-lede);
    font-family: var(--font-display);
    line-height: 1.35;
  }

  .card__detail {
    max-width: var(--measure);
    color: var(--text-muted);
  }

  .card__block {
    display: grid;
    gap: var(--space-3);
    padding-block-start: var(--space-4);
    border-block-start: var(--border);
  }

  .card__part {
    display: grid;
    gap: var(--space-1);
    padding-inline-start: 1.1em;
    color: var(--text-muted);
  }

  .card__part li::marker {
    color: var(--accent-text);
  }

  .card__foot {
    display: grid;
    gap: var(--space-5);
    margin-block-start: auto;
    padding-block-start: var(--space-5);
    border-block-start: var(--border);
  }

  .card__stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) 0;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    color: var(--text-muted);
  }

  .card__stack li:not(:last-child)::after {
    content: '/';
    margin-inline: var(--space-2);
    color: var(--text-faint);
  }

  .card__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
  }

  .card__links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-weight: 500;
  }

  .card__links a:not(.card__link--main) {
    color: var(--text-muted);
  }

  .card__links a:not(.card__link--main):hover {
    color: var(--text);
  }

  @media (min-width: 48rem) {
    .card {
      padding: var(--space-7) var(--space-6);
    }

    .card--featured {
      grid-column: 1 / -1;
    }
  }

  /* O case principal ocupa a largura toda, com o texto ao lado dos metadados. */
  @media (min-width: 64rem) {
    .card--featured {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
      align-content: start;
      column-gap: var(--space-8);
    }

    .card--featured .card__head {
      grid-row: span 2;
      align-content: start;
    }

    .card--featured h3 {
      font-size: var(--text-h2);
      line-height: var(--leading-heading);
      letter-spacing: var(--tracking-heading);
    }

    .card--featured .card__foot {
      grid-column: 2;
    }
  }
</style>
