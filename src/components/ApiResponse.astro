---
import { highlightJson, type Json } from '../lib/json';

interface Props {
  method: 'GET' | 'POST' | 'PUT' | 'DELETE';
  path: string;
  status: number;
  statusText: string;
  body: Json;
}

const { method, path, status, statusText, body } = Astro.props;
const isError = status >= 400;
---

<figure class="api">
  <figcaption class="api__request">
    <span><span class="api__method">{method}</span> <span class="api__path">{path}</span></span>
    <span class:list={['api__status', { 'api__status--error': isError }]}>{status} {statusText}</span>
  </figcaption>
  <pre class="api__body"><code set:html={highlightJson(body)} /></pre>
</figure>

<style>
  .api {
    border: var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: var(--text-small);
    overflow: hidden;
  }

  .api__request {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
    padding: var(--space-3) var(--space-5);
    border-block-end: var(--border);
    background: var(--surface-raised);
  }

  .api__method {
    color: var(--accent-text);
    font-weight: 600;
  }

  .api__path {
    color: var(--text);
  }

  .api__status {
    color: var(--text-muted);
  }

  .api__status::before {
    content: '';
    display: inline-block;
    inline-size: 0.5em;
    block-size: 0.5em;
    margin-inline-end: 0.5em;
    border-radius: 50%;
    background: var(--accent-text);
    vertical-align: 0.1em;
  }

  /* Erro: ponto vazado, para não depender só de cor. */
  .api__status--error::before {
    background: transparent;
    box-shadow: inset 0 0 0 1px currentColor;
  }

  /* Quebra linhas em vez de rolar: no mobile nada fica escondido. */
  .api__body {
    margin: 0;
    padding: var(--space-5);
    font-size: inherit;
    line-height: 1.7;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .api__body :global(.json-line) {
    display: block;
    padding-inline-start: calc((var(--depth) + 1) * 2ch);
    text-indent: -2ch;
  }

  .api__body :global(.json-key) {
    color: var(--text-muted);
  }

  .api__body :global(.json-string) {
    color: var(--text);
  }

  .api__body :global(.json-literal) {
    color: var(--accent-text);
  }

  .api__body :global(.json-punct) {
    color: var(--text-faint);
  }
</style>
