---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import Hero from '../sections/Hero.astro';
import Sobre from '../sections/Sobre.astro';
import Projetos from '../sections/Projetos.astro';
import Habilidades from '../sections/Habilidades.astro';
import Trajetoria from '../sections/Trajetoria.astro';
import Contato from '../sections/Contato.astro';
---

<BaseLayout title={site.title} description={site.description}>
  <Hero />
  <Sobre />
  <Projetos />
  <Habilidades />
  <Trajetoria />
  <Contato />
</BaseLayout>
